/* pages/monitor/monitor.wxss */
.monitor-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
}

/* 视频区域 */
.video-section {
  background: #000;
  position: relative;
}

.video-container {
  position: relative;
  width: 100%;
  height: 500rpx;
}

.video-player {
  width: 100%;
  height: 100%;
}

.video-error {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #333;
  color: white;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.retry-btn {
  background: #4CAF50;
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  border: none;
}

.retry-btn::after {
  border: none;
}

/* 视频控制按钮 */
.video-controls {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border: none;
}

.control-btn:last-child {
  margin-bottom: 0;
}

.control-btn::after {
  border: none;
}

.control-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 视频状态信息 */
.video-status {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  display: flex;
  flex-direction: column;
}

.status-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.status-item:last-child {
  margin-bottom: 0;
}

.status-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-right: 8rpx;
}

.status-value {
  font-size: 24rpx;
  color: white;
  background: rgba(0, 0, 0, 0.5);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-value.online {
  color: #4CAF50;
}

.status-value.offline {
  color: #f44336;
}

/* 控制区域 */
.control-section {
  padding: 32rpx;
}

/* 灌溉控制 */
.irrigation-control {
  margin-bottom: 32rpx;
}

.control-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.control-icon-large {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.control-info {
  flex: 1;
}

.control-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.control-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.device-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.status-idle {
  background: #e0e0e0;
  color: #666;
}

.status-running {
  background: #e8f5e8;
  color: #4CAF50;
}

.status-error {
  background: #ffebee;
  color: #f44336;
}

/* 运行状态 */
.running-status {
  text-align: center;
}

.countdown-display {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
}

.countdown-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
}

.countdown-time {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
  font-family: 'Courier New', monospace;
}

.progress-bar {
  margin-bottom: 32rpx;
}

.stop-btn {
  background: #f44336;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stop-btn::after {
  border: none;
}

/* 控制面板 */
.control-panel {
  display: flex;
  flex-direction: column;
}

.duration-selector {
  margin-bottom: 32rpx;
}

.selector-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.duration-options {
  display: flex;
  justify-content: space-between;
}

.duration-option {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  margin: 0 8rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: white;
  font-size: 28rpx;
  color: #666;
}

.duration-option:first-child {
  margin-left: 0;
}

.duration-option:last-child {
  margin-right: 0;
}

.duration-option.selected {
  border-color: #4CAF50;
  background: #e8f5e8;
  color: #4CAF50;
  font-weight: bold;
}

.start-btn {
  background: #4CAF50;
  color: white;
  border-radius: 12rpx;
  padding: 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.start-btn.disabled {
  background: #ccc;
  color: #999;
}

.start-btn::after {
  border: none;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

/* 环境信息 */
.environment-info {
  
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info-time {
  font-size: 24rpx;
  color: #666;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.info-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}