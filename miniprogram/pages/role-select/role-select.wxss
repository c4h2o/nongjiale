/* pages/role-select/role-select.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 20rpx;
  margin-bottom: 30rpx;
}

.header-content {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.header-decoration {
  font-size: 60rpx;
  opacity: 0.8;
}

/* 角色容器 */
.roles-container {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
  margin-bottom: 40rpx;
}

/* 角色卡片 */
.role-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  border: 3rpx solid #e9ecef;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.role-card.selected {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.role-card:active {
  transform: scale(0.98);
}

/* 角色头部 */
.role-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.role-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-text {
  font-size: 40rpx;
}

.role-info {
  flex: 1;
}

.role-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.role-subtitle {
  font-size: 24rpx;
  font-weight: 500;
}

/* 选择器 */
.role-selector {
  margin-left: 20rpx;
}

.selector-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #e9ecef;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.selector-circle.selected {
  border-width: 3rpx;
}

.selector-check {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

/* 角色描述 */
.role-description {
  margin-bottom: 25rpx;
}

.description-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 角色特点 */
.role-features {
  margin-bottom: 25rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-dot {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 15rpx;
  margin-top: 2rpx;
}

.feature-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  flex: 1;
}

/* 角色操作 */
.role-actions {
  text-align: right;
}

.learn-more-btn {
  background: #f8f9fa;
  color: #666;
  border: 1rpx solid #e9ecef;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.learn-more-btn::after {
  border: none;
}

.learn-more-btn:active {
  background: #e9ecef;
}

/* 确认容器 */
.confirm-container {
  margin-bottom: 30rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.active {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.confirm-btn.disabled {
  background: #e9ecef;
  color: #999;
}

.confirm-btn.active:active {
  transform: scale(0.98);
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  flex: 1;
  height: 70rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 35rpx;
  background: white;
  color: #666;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.skip-btn:active {
  background: #f8f9fa;
}

.contact-btn {
  border-color: #4CAF50;
  color: #4CAF50;
}

.contact-btn:active {
  background: #f1f8e9;
}

/* 温馨提示 */
.tip-section {
  background: white;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .container {
    padding: 15rpx;
  }
  
  .header {
    padding: 30rpx 15rpx;
  }
  
  .header-title {
    font-size: 36rpx;
  }
  
  .role-card {
    padding: 25rpx;
  }
  
  .role-icon {
    width: 70rpx;
    height: 70rpx;
  }
  
  .icon-text {
    font-size: 36rpx;
  }
  
  .bottom-actions {
    flex-direction: column;
  }
}