/* pages/garden-bind/garden-bind.wxss */
.bind-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 32rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.page-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 绑定表单 */
.bind-form {
  margin-bottom: 32rpx;
}

.form-section {
  margin-bottom: 40rpx;
}

.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  color: #333;
}

.required {
  color: #f44336;
  margin-left: 8rpx;
}

.input-container {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: white;
  overflow: hidden;
}

.garden-id-input {
  flex: 1;
  padding: 24rpx;
  font-size: 32rpx;
  color: #333;
}

.scan-btn {
  width: 88rpx;
  height: 88rpx;
  background: #4CAF50;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
}

.scan-btn::after {
  border: none;
}

.scan-icon {
  width: 48rpx;
  height: 48rpx;
}

.input-tip {
  margin-top: 12rpx;
}

.input-tip text {
  font-size: 24rpx;
  color: #999;
}

.bind-btn {
  width: 100%;
  background: #4CAF50;
  color: white;
  border-radius: 12rpx;
  padding: 32rpx;
  font-size: 36rpx;
  font-weight: bold;
  border: none;
}

.bind-btn.loading {
  opacity: 0.7;
}

.bind-btn::after {
  border: none;
}

/* 绑定说明 */
.bind-info {
  margin-bottom: 32rpx;
}

.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-number {
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  padding-top: 8rpx;
}

/* 绑定历史 */
.history-section {
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.history-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.history-location {
  font-size: 24rpx;
  color: #666;
}

.history-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.status-active {
  background: #e8f5e8;
  color: #4CAF50;
}

.status-inactive {
  background: #fff3e0;
  color: #ff9800;
}

.status-maintenance {
  background: #ffebee;
  color: #f44336;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
}