/* pages/services/services.wxss */
.services-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
  padding: 40rpx 32rpx;
  color: white;
  text-align: center;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.page-desc {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
}

/* 服务列表 */
.services-list {
  padding: 32rpx;
}

.service-item {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.service-item:last-child {
  margin-bottom: 0;
}

/* 服务头部 */
.service-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.service-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
}

.service-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.service-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.service-price {
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: bold;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 服务描述 */
.service-description {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.service-description text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 服务详情 */
.service-details {
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  margin-bottom: 12rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  line-height: 1.4;
}

/* 服务操作 */
.service-actions {
  text-align: center;
}

.book-btn {
  background: #4CAF50;
  color: white;
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  width: 100%;
}

.book-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 服务说明 */
.service-notice {
  margin: 32rpx;
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.notice-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.notice-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.notice-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.notice-content {
  display: flex;
  flex-direction: column;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.notice-item:last-child {
  margin-bottom: 0;
}

.notice-number {
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  padding-top: 8rpx;
}