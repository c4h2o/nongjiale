/* pages/gardens/gardens.wxss */
.gardens-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
}

/* 菜园列表 */
.gardens-list {
  padding: 32rpx;
}

.garden-item {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.garden-item:last-child {
  margin-bottom: 0;
}

/* 菜园头部 */
.garden-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.garden-info {
  display: flex;
  flex-direction: column;
}

.garden-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.garden-id {
  font-size: 24rpx;
  color: #666;
}

.garden-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.status-active {
  background: #e8f5e8;
  color: #4CAF50;
}

.status-inactive {
  background: #fff3e0;
  color: #ff9800;
}

.status-maintenance {
  background: #ffebee;
  color: #f44336;
}

/* 菜园详情 */
.garden-details {
  margin-bottom: 24rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.detail-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.detail-text {
  font-size: 28rpx;
  color: #666;
}

/* 菜园操作 */
.garden-actions {
  display: flex;
  justify-content: space-between;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  margin: 0 8rpx;
}

.action-btn:first-child {
  margin-left: 0;
}

.action-btn:last-child {
  margin-right: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: #4CAF50;
  color: white;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.bind-btn {
  background: #4CAF50;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-btn::after {
  border: none;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.add-garden-btn {
  width: 100%;
  background: #4CAF50;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-garden-btn::after {
  border: none;
}

.add-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}