/* pages/application/application.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 20rpx;
  margin-bottom: 25rpx;
}

.header-content {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.header-icon {
  font-size: 60rpx;
  opacity: 0.8;
}

/* 表单容器 */
.form-container {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.form-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.form-subtitle {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 表单区块 */
.form-section {
  margin-bottom: 35rpx;
}

.form-section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 15rpx;
  border-left: 4rpx solid #4CAF50;
}

/* 输入组件 */
.input-group {
  margin-bottom: 25rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333;
}

.required {
  color: #ff4757;
  margin-left: 5rpx;
}

.label-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #4CAF50;
  background: white;
}

.input-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4CAF50;
  text-align: right;
}

/* 选择器字段 */
.picker-field {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.picker-text.placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
  transform: rotate(90deg);
}

/* 合作优势卡片 */
.advantages-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.advantages-header {
  text-align: center;
  margin-bottom: 25rpx;
}

.advantages-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.advantages-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.advantage-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.advantage-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.advantage-content {
  flex: 1;
}

.advantage-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.advantage-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 提交容器 */
.submit-container {
  margin-bottom: 25rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: white;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
  color: #999;
  box-shadow: none;
}

.submit-btn:not(.disabled):active {
  transform: scale(0.98);
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 15rpx;
  margin-bottom: 25rpx;
}

.action-btn {
  flex: 1;
  height: 70rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 35rpx;
  background: white;
  color: #666;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.reset-btn:active {
  background: #f8f9fa;
}

.contact-btn {
  border-color: #4CAF50;
  color: #4CAF50;
}

.contact-btn:active {
  background: #f1f8e9;
}

.cases-btn {
  border-color: #ff6b35;
  color: #ff6b35;
}

.cases-btn:active {
  background: #fff5f0;
}

/* 提示卡片 */
.tip-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.tip-step {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.step-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .container {
    padding: 15rpx;
  }
  
  .header {
    padding: 25rpx 15rpx;
  }
  
  .header-title {
    font-size: 36rpx;
  }
  
  .form-container {
    padding: 25rpx;
  }
  
  .advantages-list {
    grid-template-columns: 1fr;
  }
  
  .bottom-actions {
    flex-direction: column;
  }
}