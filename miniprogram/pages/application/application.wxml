<!--pages/application/application.wxml-->
<view class="container">
  <!-- 页面头部 -->
  <view class="header">
    <view class="header-content">
      <text class="header-title">入驻申请</text>
      <text class="header-subtitle">加入智慧共享菜园平台，盘活您的用地资源</text>
    </view>
    <view class="header-icon">🏪</view>
  </view>

  <!-- 申请表单 -->
  <view class="form-container">
    <view class="form-header">
      <text class="form-title">申请信息</text>
      <text class="form-subtitle">请如实填写以下信息，我们将尽快与您联系</text>
    </view>

    <!-- 联系人信息 -->
    <view class="form-section">
      <view class="section-title">联系人信息</view>
      
      <view class="input-group">
        <view class="input-label">
          <text class="label-text">联系人姓名</text>
          <text class="required">*</text>
        </view>
        <input 
          class="input-field"
          type="text"
          placeholder="请输入您的姓名"
          value="{{formData.contactName}}"
          bindinput="onContactNameInput"
          maxlength="20"
        />
      </view>

      <view class="input-group">
        <view class="input-label">
          <text class="label-text">联系电话</text>
          <text class="required">*</text>
        </view>
        <input 
          class="input-field"
          type="number"
          placeholder="请输入手机号"
          value="{{formData.contactPhone}}"
          bindinput="onContactPhoneInput"
          maxlength="11"
        />
      </view>
    </view>

    <!-- 用地信息 -->
    <view class="form-section">
      <view class="section-title">用地信息</view>
      
      <view class="input-group">
        <view class="input-label">
          <text class="label-text">用地面积</text>
          <text class="required">*</text>
          <text class="label-unit">（平方米）</text>
        </view>
        <input 
          class="input-field"
          type="digit"
          placeholder="请输入用地面积"
          value="{{formData.landArea}}"
          bindinput="onLandAreaInput"
        />
        <view wx:if="{{formData.landArea}}" class="input-hint">
          约 {{formatArea(formData.landArea)}} 平方米
        </view>
      </view>

      <view class="input-group">
        <view class="input-label">
          <text class="label-text">所在地区</text>
          <text class="required">*</text>
        </view>
        <view class="picker-field" bindtap="onLocationTap">
          <text class="picker-text {{formData.location ? '' : 'placeholder'}}">
            {{formData.location || '请选择所在地区'}}
          </text>
          <text class="picker-arrow">></text>
        </view>
      </view>
    </view>

    <!-- 地区选择器 -->
    <picker 
      wx:if="{{showRegionPicker}}"
      range="{{regions}}"
      bindchange="onRegionChange"
      bindcancel="onRegionCancel"
    >
      <view></view>
    </picker>
  </view>

  <!-- 合作优势 -->
  <view class="advantages-card">
    <view class="advantages-header">
      <text class="advantages-title">🌟 合作优势</text>
    </view>
    <view class="advantages-list">
      <view class="advantage-item">
        <text class="advantage-icon">💰</text>
        <view class="advantage-content">
          <text class="advantage-title">稳定收益</text>
          <text class="advantage-desc">获得稳定的土地租金收益</text>
        </view>
      </view>
      <view class="advantage-item">
        <text class="advantage-icon">🛠️</text>
        <view class="advantage-content">
          <text class="advantage-title">专业运营</text>
          <text class="advantage-desc">专业团队负责运营管理</text>
        </view>
      </view>
      <view class="advantage-item">
        <text class="advantage-icon">📈</text>
        <view class="advantage-content">
          <text class="advantage-title">品牌合作</text>
          <text class="advantage-desc">与知名品牌合作机会</text>
        </view>
      </view>
      <view class="advantage-item">
        <text class="advantage-icon">🤝</text>
        <view class="advantage-content">
          <text class="advantage-title">长期合作</text>
          <text class="advantage-desc">建立长期稳定合作关系</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-container">
    <button 
      class="submit-btn {{submitting ? 'disabled' : ''}}"
      bindtap="onSubmitApplication"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions">
    <button class="action-btn reset-btn" bindtap="onResetForm">
      重置表单
    </button>
    <button class="action-btn contact-btn" bindtap="onContactService">
      联系客服
    </button>
    <button class="action-btn cases-btn" bindtap="onViewCases">
      合作案例
    </button>
  </view>

  <!-- 温馨提示 -->
  <view class="tip-card">
    <view class="tip-header">
      <text class="tip-icon">💡</text>
      <text class="tip-title">申请流程</text>
    </view>
    <view class="tip-content">
      <view class="tip-step">
        <text class="step-number">1</text>
        <text class="step-text">提交申请信息</text>
      </view>
      <view class="tip-step">
        <text class="step-number">2</text>
        <text class="step-text">客服3个工作日内联系</text>
      </view>
      <view class="tip-step">
        <text class="step-number">3</text>
        <text class="step-text">实地考察评估</text>
      </view>
      <view class="tip-step">
        <text class="step-number">4</text>
        <text class="step-text">签署合作协议</text>
      </view>
      <view class="tip-step">
        <text class="step-number">5</text>
        <text class="step-text">开始运营合作</text>
      </view>
    </view>
  </view>
</view>