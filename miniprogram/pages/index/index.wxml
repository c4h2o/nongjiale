<!--pages/index/index.wxml-->
<view class="index-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <!-- 主要内容 -->
  <view wx:else>
    <!-- 用户信息卡片 -->
    <view class="user-card card">
      <view class="user-info">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="user-details">
          <text class="nickname">{{userInfo.nickname}}</text>
          <text class="garden-count">已绑定 {{gardenCount}} 个菜园</text>
        </view>
      </view>
      <view class="user-actions">
        <button class="action-btn" bindtap="goToGardenBind">
          <image class="action-icon" src="/images/add.png"></image>
          <text>绑定菜园</text>
        </button>
      </view>
    </view>

    <!-- 快捷功能 -->
    <view class="quick-actions">
      <view class="action-item" bindtap="goToGardens">
        <image class="action-image" src="/images/garden-large.png"></image>
        <text class="action-title">我的菜园</text>
        <text class="action-desc">查看和管理菜园</text>
      </view>
      <view class="action-item" bindtap="goToServices">
        <image class="action-image" src="/images/service-large.png"></image>
        <text class="action-title">农事服务</text>
        <text class="action-desc">预约专业服务</text>
      </view>
      <view class="action-item" bindtap="goToPromotion">
        <image class="action-image" src="/images/promotion-large.png"></image>
        <text class="action-title">推广中心</text>
        <text class="action-desc">邀请好友获奖励</text>
      </view>
    </view>

    <!-- 最近订单 -->
    <view wx:if="{{recentOrders.length > 0}}" class="recent-orders card">
      <view class="section-header">
        <text class="section-title">最近订单</text>
        <text class="section-more" bindtap="goToOrders">查看全部</text>
      </view>
      <view class="order-list">
        <view wx:for="{{recentOrders}}" wx:key="id" class="order-item">
          <view class="order-info">
            <text class="order-service">{{item.serviceName}}</text>
            <text class="order-date">{{item.appointmentDate}}</text>
          </view>
          <view class="order-status status-{{item.status}}">
            {{item.status === 'pending' ? '待确认' : 
              item.status === 'confirmed' ? '已确认' : 
              item.status === 'completed' ? '已完成' : '已取消'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态提示 -->
    <view wx:if="{{gardenCount === 0}}" class="empty-state card">
      <image class="empty-image" src="/images/empty-garden.png"></image>
      <text class="empty-title">还没有绑定菜园</text>
      <text class="empty-desc">绑定菜园后即可远程监控和管理</text>
      <button class="btn-primary" bindtap="goToGardenBind">立即绑定</button>
    </view>
  </view>
</view>